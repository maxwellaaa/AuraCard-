{
  "name": "auracard",
  "private": true,
  "version": "1.0.3",
  "description": "光语 AuraCard — AI 图文卡片桌面端",
  "author": "AuraCard",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "electron:dev": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.yml -c.directories.output=E:/cursor-agent/deliverables/AuraCard-desktop-1.0.3",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.yml",
    "dist:dir": "npm run build && electron-builder --win dir --config electron-builder.yml"
  },
  "dependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/marked": "^6.0.0",
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.1",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "marked": "^17.0.5",
    "marked-highlight": "^2.1.3",
    "md-editor-v3": "^6.4.1",
    "vue": "^3.4.38",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.6.2",
    "autoprefixer": "^10.5.4",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.20",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.4",
    "vite": "^4.5.5",
    "vue-tsc": "^2.0.29"
  }
}
